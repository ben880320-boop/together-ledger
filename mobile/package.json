{
  "name": "together-ledger-android",
  "version": "1.3.11",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android:ci": "pnpm run prebuild:android && cd android && ./gradlew --no-daemon --stacktrace assembleDebug",
