        "foregroundImage": "./assets/together-ledger-icon.png",
        "backgroundColor": "#C87A8A"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser", "expo-image-picker"],
    "experiments": {
